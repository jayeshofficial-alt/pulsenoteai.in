{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with plan, credits, notesUsedThisMonth, and teamId",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "pro", "team"] },
        "notesUsedThisMonth": { "type": "number" },
        "monthResetAt": { "type": "string" },
        "credits": { "type": "number" },
        "teamId": { "type": "string" },
        "referredBy": { "type": "string" },
        "referralCode": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "DictionaryTerm": {
      "title": "DictionaryTerm",
      "description": "User custom vocabulary / spelling hints for voice transcription & clinical notes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "term": { "type": "string", "maxLength": 120 },
        "replacement": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "term"]
    },
    "FeatureSettings": {
      "title": "FeatureSettings",
      "description": "Admin toggle for image and video generation",
      "type": "object",
      "properties": {
        "imageGenerationEnabled": { "type": "boolean" },
        "videoGenerationEnabled": { "type": "boolean" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["imageGenerationEnabled", "videoGenerationEnabled"]
    },
    "Team": {
      "title": "Team",
      "description": "Team account with seats and members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "name": { "type": "string" },
        "seats": { "type": "number" },
        "members": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "ownerUid", "name", "seats"]
    },
    "VideoJob": {
      "title": "VideoJob",
      "description": "Veo video generation job tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "operationName": { "type": "string" },
        "prompt": { "type": "string" },
        "status": { "type": "string", "enum": ["processing", "completed", "failed"] },
        "videoUrl": { "type": "string" },
        "error": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "operationName", "status"]
    },
    "PartnerLead": {
      "title": "PartnerLead",
      "description": "Partner inquiries and lead submissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "organization": { "type": "string" },
        "type": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "organization"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/FeatureSettings" },
      "description": "Global feature toggles readable by authenticated users and editable by admins"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile document owned by userId or accessible by admins"
    },
    "/users/{userId}/dictionary/{termId}": {
      "schema": { "$ref": "#/entities/DictionaryTerm" },
      "description": "Personal custom vocabulary terms scoped to a user"
    },
    "/teams/{teamId}": {
      "schema": { "$ref": "#/entities/Team" },
      "description": "Team workspaces shared among invited members"
    },
    "/videoJobs/{jobId}": {
      "schema": { "$ref": "#/entities/VideoJob" },
      "description": "Server-managed video generation jobs readable by owner or admin"
    },
    "/partnerLeads/{leadId}": {
      "schema": { "$ref": "#/entities/PartnerLead" },
      "description": "Inbound partner inquiries readable and manageable by admins"
    }
  }
}
