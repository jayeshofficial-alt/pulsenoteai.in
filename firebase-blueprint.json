{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role, subscription tier and stats",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "isPro": { "type": "boolean" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Multi-turn Gemini chat threads and notes history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "modelRole": { "type": "string" },
        "lens": { "type": "string" },
        "messages": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Generated images, videos, audio music tracks and transcriptions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "prompt": { "type": "string" },
        "modelUsed": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "aspectRatio": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "type", "prompt"]
    },
    "DocumentRecord": {
      "title": "DocumentRecord",
      "description": "Generated SOAP notes, executive memos, engineering RFCs and reports",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "industry": { "type": "string" },
        "rawInput": { "type": "string" },
        "markdownReport": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "industry"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "entity": "User",
      "rules": {
        "read": "request.auth != null && request.auth.uid == userId",
        "write": "request.auth != null && request.auth.uid == userId"
      }
    },
    "/users/{userId}/threads/{threadId}": {
      "entity": "ChatThread",
      "rules": {
        "read": "request.auth != null && request.auth.uid == userId",
        "write": "request.auth != null && request.auth.uid == userId"
      }
    },
    "/users/{userId}/documents/{documentId}": {
      "entity": "DocumentRecord",
      "rules": {
        "read": "request.auth != null && request.auth.uid == userId",
        "write": "request.auth != null && request.auth.uid == userId"
      }
    },
    "/users/{userId}/media/{mediaId}": {
      "entity": "MediaAsset",
      "rules": {
        "read": "request.auth != null && request.auth.uid == userId",
        "write": "request.auth != null && request.auth.uid == userId"
      }
    }
  }
}
