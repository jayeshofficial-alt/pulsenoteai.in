# OpenRouter API Key — powers the live chat/SOAP engine
# Get/manage keys at: https://openrouter.ai/workspaces/default/keys
OPENROUTER_API_KEY=
VITE_OPENROUTER_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=http://localhost:3000

# CODECRAFT_API: Endpoint and API Key for CodeCraft API integration
CODECRAFT_API_URL=
CODECRAFT_API_BASE_URL=
CODECRAFT_API_KEY=

# Razorpay (payment gateway) — use TEST keys for development
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_TEAM=