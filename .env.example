# OPENROUTER_API_KEY: Required for OpenRouter AI API calls.
# Configure your OpenRouter key (starts with sk-or-v1-...)
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# Client-side OpenRouter API key for Vite SPA direct access
VITE_OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CODECRAFT_API: Endpoint and API Key for CodeCraft API integration
CODECRAFT_API_URL="https://codecraftapi.com/v1"
CODECRAFT_API_BASE_URL="https://codecraftapi.com/v1"
CODECRAFT_API_KEY="YOUR_CODECRAFT_API_KEY"
